<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo desenfocado -->
    <ImageView
        android:id="@+id/doorsBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_backgroud_desenfocado"
        android:contentDescription="@string/app_name" />

    <!-- Logo minimalista -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="139dp"
        android:layout_height="146dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.7"
        android:src="@drawable/logo_minimalista"
        app:layout_constraintBottom_toTopOf="@+id/serviceButtonsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Contenedor vertical de botones -->
    <LinearLayout
        android:id="@+id/serviceButtonsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.572">

        <!-- Uber Eats -->

        <!-- Uber Transporte -->

        <!-- Glovo -->
        <LinearLayout
            android:id="@+id/btnUberRide"
            android:layout_width="200dp"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/rounded_dark_background"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_uber_ride" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Uber Transporte"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnUberEats"
            android:layout_width="200dp"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/rounded_dark_background"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_ubereats" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Uber Eats"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnGlovo"
            android:layout_width="200dp"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_dark_background"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_glovo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Glovo"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
